# =====================================================================
# templates/scenario.tmpl -- the parameterised scenario template
# Rendered by generate.py into generated/run_<id>/scenario.txt. Never edit the artefact by hand.
#
# Placeholders use double braces, not dollar braces:
#   AFSIM's own preprocessor substitutes text with $define / $<X>$,
#   and would read a dollar brace as a preprocessor variable with a default. The two collide.
# =====================================================================
# run_id={{RUN_ID}}  seed={{SEED}}  red_speed={{RED_SPEED}}  r0={{R0_KM}}

log_file output/scenario.log

# ---- global parameters: must precede every include_once ----
script_variables
   double FIRE_RANGE_M = {{FIRE_RANGE_M}};
   string TARGET_NAME  = "red_01";
end_script_variables

# ---- event output: no enable list means zero bytes ----
event_output
   file output/scenario.evt
   enable PLATFORM_ADDED
   enable SENSOR_TRACK_INITIATED
   enable WEAPON_FIRED
   enable WEAPON_HIT
   enable WEAPON_MISSED
   enable PLATFORM_BROKEN
end_event_output

# ---- component library: reference the third layer only; it pulls the first two in ----
include_once ../../library/theater/blue_fighter.txt

# ---- the instance: the only place concrete numbers are allowed ----
platform blue_01 BLUE_FIGHTER
   side blue
   route
      position {{BLUE_LAT}} {{BLUE_LON}} altitude 25000 ft msl
         speed 250 m/sec
      position {{BLUE_LAT_END}} {{BLUE_LON_END}} altitude 25000 ft msl
         speed 250 m/sec
   end_route
end_platform

platform red_01 RED_TARGET
   route
      position {{RED_LAT}} {{RED_LON}} altitude 25000 ft msl
         speed {{RED_SPEED}} m/sec
      position {{RED_LAT_END}} {{RED_LON_END}} altitude 25000 ft msl
         speed {{RED_SPEED}} m/sec
   end_route
end_platform

random_seed {{SEED}}
end_time {{END_TIME}} s
